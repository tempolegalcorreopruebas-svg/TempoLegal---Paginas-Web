# Hostinger / Apache / LiteSpeed configuration. Publication is not enabled by this file.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:_tools|_herramientas|tempo-private|server)(?:/|$) - [F,L]
RewriteCond %{HTTP_HOST} ^www\.tempolegal\.com$ [NC]
RewriteRule ^ https://tempolegal.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^politica\-de\-privacidad\.html$ /politica-de-privacidad/ [R=301,L,NE]
RewriteRule ^article\-data\-protection\-officer\.html$ /dpd-obligatorio-ecuador-2026-criterios-spdp/ [R=301,L,NE]
RewriteRule ^terminos\-y\-condiciones\.html$ /terminos-y-condiciones/ [R=301,L,NE]
RewriteRule ^en/politica\-de\-privacidad\.html$ /en/politica-de-privacidad/ [R=301,L,NE]
RewriteRule ^en/article\-data\-protection\-officer\.html$ /en/dpd-obligatorio-ecuador-2026-criterios-spdp/ [R=301,L,NE]
RewriteRule ^pt/politica\-de\-privacidad\.html$ /pt/politica-de-privacidad/ [R=301,L,NE]
RewriteRule ^pt/article\-data\-protection\-officer\.html$ /pt/dpd-obligatorio-ecuador-2026-criterios-spdp/ [R=301,L,NE]
RewriteRule ^fr/politica\-de\-privacidad\.html$ /fr/politica-de-privacidad/ [R=301,L,NE]
RewriteRule ^fr/article\-data\-protection\-officer\.html$ /fr/dpd-obligatorio-ecuador-2026-criterios-spdp/ [R=301,L,NE]
RewriteRule ^en/services/accounting\-support/(?:index\.html)?$ /en/servicios-contabilidad/ [R=301,L,NE]
RewriteRule ^en/services/legal\-representation/(?:index\.html)?$ /en/representacion-legal-fiscal-ecuador/ [R=301,L,NE]
RewriteRule ^en/services/sas\-incorporation/(?:index\.html)?$ /en/constitucion-de-empresas-sas/ [R=301,L,NE]
RewriteRule ^en/services/corporate\-amendments/(?:index\.html)?$ /en/tramites-notariales-y-societarios/ [R=301,L,NE]
RewriteRule ^services/accounting\-support/(?:index\.html)?$ /servicios-contabilidad/ [R=301,L,NE]
RewriteRule ^services/legal\-representation/(?:index\.html)?$ /representacion-legal-fiscal-ecuador/ [R=301,L,NE]
RewriteRule ^services/sas\-incorporation/(?:index\.html)?$ /constitucion-de-empresas-sas/ [R=301,L,NE]
RewriteRule ^services/corporate\-amendments/(?:index\.html)?$ /tramites-notariales-y-societarios/ [R=301,L,NE]
RewriteRule ^pt/services/accounting\-support/(?:index\.html)?$ /pt/servicios-contabilidad/ [R=301,L,NE]
RewriteRule ^pt/services/legal\-representation/(?:index\.html)?$ /pt/representacion-legal-fiscal-ecuador/ [R=301,L,NE]
RewriteRule ^pt/services/sas\-incorporation/(?:index\.html)?$ /pt/constitucion-de-empresas-sas/ [R=301,L,NE]
RewriteRule ^pt/services/corporate\-amendments/(?:index\.html)?$ /pt/tramites-notariales-y-societarios/ [R=301,L,NE]
RewriteRule ^fr/services/accounting\-support/(?:index\.html)?$ /fr/servicios-contabilidad/ [R=301,L,NE]
RewriteRule ^fr/services/legal\-representation/(?:index\.html)?$ /fr/representacion-legal-fiscal-ecuador/ [R=301,L,NE]
RewriteRule ^fr/services/sas\-incorporation/(?:index\.html)?$ /fr/constitucion-de-empresas-sas/ [R=301,L,NE]
RewriteRule ^fr/services/corporate\-amendments/(?:index\.html)?$ /fr/tramites-notariales-y-societarios/ [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+[^\s?]*index\.html(?:[?\s]) [NC]
RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
# Keep this header until the final indexability/publication checklist is approved.
Header always set X-Robots-Tag "noindex, follow"
Header always set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "^(?:\.env|composer\.(?:json|lock)|config\.example\.php)$">
Require all denied
</FilesMatch>
